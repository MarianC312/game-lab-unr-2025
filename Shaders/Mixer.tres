	float n_out14p4 = n_out14p0.a;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, UV);


// Output:0
	ALBEDO = n_out12p0;
	ROUGHNESS = n_out4p0.x;
	NORMAL_MAP = vec3(n_out14p4);
	NORMAL_MAP_DEPTH = n_out3p0.x;


}
