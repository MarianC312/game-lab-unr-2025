void fragment() {
// Input:6
	vec2 n_out6p0 = UV;


// FloatConstant:7
	float n_out7p0 = 10.000000;


// UVFunc:5
	vec2 n_in5p2 = vec2(0.00000, 0.00000);
	vec2 n_out5p0 = n_in5p2 * vec2(n_out7p0) + n_out6p0;


