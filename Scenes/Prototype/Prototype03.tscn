[node name="StaticBody3D" type="StaticBody3D" parent="Mundo/Mapin/Interactables/Bandolero" groups=["Interactable"]]
script = ExtResource("13_uu1up")
object_name = "12. Bandolero"
required = false
map = "Mapa03"
photo = ExtResource("15_iaoyj")
text_content = "La alta desocupación por el cierre de obrajeros llevaron a los trabajadores del monte, al bandidaje como los calificaban que los medios burgueses; personas que hacían justicia por mano propia. 
Para algunos eran considerados delincuentes y para otros eran benefactores o rebeldes."
should_highlight = false

[node name="CollisionShape3D" type="CollisionShape3D" parent="Mundo/Mapin/Interactables/Bandolero/StaticBody3D"]
