[node name="JuanMoreira" type="MeshInstance3D" parent="Mundo/Mapin/Interactables"]

[node name="StaticBody3D" type="StaticBody3D" parent="Mundo/Mapin/Interactables/JuanMoreira" groups=["Interactable"]]
script = ExtResource("13_uu1up")
object_name = "13. Juan Moreira"
required = false
map = "Mapa03"
photo = ExtResource("16_pvix0")
text_content = "Fue un gaucho argentino que se convirtió en una leyenda popular tras sufrir injusticias, abusos de poder y transformarse en un rebelde perseguido. 
Conocido por su habilidad con el facón, murió en un enfrentamiento en Lobos y su vida inspiró la famosa novela que se entregaba en folletines de Eduardo Gutiérrez."
should_highlight = false

[node name="CollisionShape3D" type="CollisionShape3D" parent="Mundo/Mapin/Interactables/JuanMoreira/StaticBody3D"]
shape = SubResource("BoxShape3D_vu0bf")

[node name="Brazalete" type="MeshInstance3D" parent="Mundo/Mapin/Interactables"]

[node name="StaticBody3D" type="StaticBody3D" parent="Mundo/Mapin/Interactables/Brazalete" groups=["Interactable"]]
script = ExtResource("13_uu1up")
object_name = "12. Brazalete HUARPE"
required = false
map = "Mapa03"
photo = ExtResource("16_pje4i")
text_content = "Martina Chapanay era descendiente de un cacique huarpe, se identificaban con el agua, el sol y la luna, animales del entorno y diseños geométricos. 
Su identidad se basaba en la comunidad, el linaje y la relación espiritual con la tierra. Los pueblos originarios no contaban con una bandera única en ese momento."
should_highlight = false

