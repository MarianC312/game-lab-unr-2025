[node name="Quebracho" type="MeshInstance3D" parent="Mundo/Interactables"]

[node name="StaticBody3D" type="StaticBody3D" parent="Mundo/Interactables/Quebracho" groups=["Interactable"]]
script = ExtResource("5_k6idn")
object_name = "14. Quebracho"
required = false
map = "Mapa03"
photo = ExtResource("6_k6idn")
text_content = "Quebracho es el nombre colonial español, quiebra hacha. En qom es naalá y en wichi es sachaj. Nativo del noroeste argentino y presente en Bolivia, Paraguay y Brasil, crece en bosques densos. Fue explotado por su tanino y madera, dejando los montes vulnerables. Los obreros lo pelaban a mano hasta el centro rojo, el oro rojo."
should_highlight = false

[node name="CollisionShape3D" type="CollisionShape3D" parent="Mundo/Interactables/Quebracho/StaticBody3D"]
shape = SubResource("BoxShape3D_86wte")

[node name="Hacha" type="MeshInstance3D" parent="Mundo/Interactables"]

[node name="StaticBody3D" type="StaticBody3D" parent="Mundo/Interactables/Hacha" groups=["Interactable"]]
script = ExtResource("5_k6idn")
object_name = "15. Hacha"
required = false
map = "Mapa03"
photo = ExtResource("7_a5eq5")
text_content = "El hacha, reforzada y de acero grueso, tenía cabo fuerte por la dureza del quebracho. Dos o tres hacheros tardaban 2 horas en talarlo y hasta día y medio en llegar al corazón rojo. Niños y mujeres abrían camino entre matorrales y telas de arañas; no cobraban salario."
should_highlight = false

