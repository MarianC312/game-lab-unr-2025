object_name = "10. Whisky y Gin"
required = false
map = "Mapa02"
photo = ExtResource("50_h75h1")
text_content = "Eran las bebidas preferidas por la élite, azucaradas e importadas. 
Con un estilo de vida afrancesado preferían tragos dulces como el gin tonic, el whisky escoses, champagne francés y licores finos."
