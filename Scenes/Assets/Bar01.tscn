[node name="StaticBody3D" type="StaticBody3D" parent="Interactables/FORA" groups=["Interactable"]]
script = ExtResource("29_mhgoa")
object_name = "9. F.O.R.A."
required = false
map = "Mapa02"
photo = ExtResource("50_kvgrm")
text_content = "La Federación Obrera Regional Argentina era obrera de variadas tendencias ideológicas, pero no era partidaria de ninguna filosofía en particular, tuvo dificultades para ingresar propaganda a los obrajes hasta que en 1919 sindicatos y centros obreros permitieron distribuir volantes, extendiendo la rebeldía en el latifundio."
should_highlight = false

