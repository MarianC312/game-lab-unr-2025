object_name = "7. Amargo Obrero"
dialogue = ExtResource("30_xidfh")
required = false
map = "Mapa02"
photo = ExtResource("38_v5vxu")
text_content = "El Amargo Obrero nació en Rosario, creado por los italianos Pedro Calatroni y Antonio Tacconi. Inspirado en los amari, combina 45 hierbas argentinas con alcohol,agua y azúcar. Su nombre y etiqueta, el puño y la hoz, lo vinculan al movimiento obrero como la bebida del pueblo."

